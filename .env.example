# Smart Chicken Farm server secrets. ./start.sh creates .env from this file and fills the generated values.
# Read by Node-RED (and the two MQTT passwords by Mosquitto). Never copy these into the web folder.
# (Docker does not allow comments at the end of a line here: keep comments on their own line.)

SUPABASE_URL=https://qagcsesgiixpbyawonuu.supabase.co
# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
SUPABASE_KEY=sb_secret_PUT_YOUR_SECRET_KEY_HERE

# ---- generated by start.sh (random, keep secret) ----
# signs login tokens; changing it logs everybody out
SESSION_SECRET=
# Node-RED's MQTT account
MQTT_NODERED_PASSWORD=
# first gateway (gw1); also written into firmware/gateway/secrets.h
MQTT_GW1_PASSWORD=
# Node-RED editor /admin (user: admin)
NR_EDITOR_PASSWORD=
# first web account "admin" (used only while there are no users yet)
ADMIN_PASSWORD=
# ESP-NOW HMAC key of the first farm; also in both secrets.h
FARM_KEY=

# Default comfort range for coops without a flock (with a flock, the target follows the birds' age)
TEMP_MIN=18
TEMP_MAX=30
HUM_MIN=50
HUM_MAX=70

# ---- 2-step login (authenticator app) ----
# roles that must use it (comma separated); empty = optional for everyone. Default: admin,keeper
#MFA_REQUIRED_ROLES=admin,keeper
# emergency: the only admin lost the phone and the backup codes -> put the username here, run ./start.sh,
# log in with the password (sets up a new phone), then remove this line
#MFA_RESET_USER=
